# Casper server configuration. Copy to .env; the installer writes it for you.
#
# Every setting below also works in ~/.config/casper/config.json under its camelCase
# name (host, port, token...). The environment wins over that file, so setting one
# thing in both places is just a way to confuse yourself. The three under "Install
# layout" are environment-only.

HOST=0.0.0.0
PORT=4319

# Entered once at login and exchanged for a per-device cookie; only its hash is
# stored. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CASPER_TOKEN=change-me

# Device-login lifetime, slid forward on activity. Default 7 days. Changing
# CASPER_TOKEN does not revoke existing logins - `casper reset-token` does both.
# CASPER_SESSION_TTL_SECONDS=604800

KIRO_BIN=kiro-cli

# Working directory for new sessions. Defaults to the server's own.
DEFAULT_CWD=/home/youruser/projects

# The installer links assets/agents/casper.json into ~/.kiro/agents and sets this,
# falling back to kiro_default if that agent won't validate.
DEFAULT_AGENT=casper

# Confines the file browser and image endpoints. Defaults to /, meaning everything
# the server can read; narrow it to stop authenticated users reaching system files.
# CASPER_FILE_ROOT=/home/youruser

# Live kiro-cli processes kept in memory. Sessions past this go dormant and resume
# on demand.
MAX_LIVE_SESSIONS=6

# Events buffered per session for reconnect replay.
# EVENT_BUFFER_SIZE=5000

# Largest single upload, in bytes. Default 100 MB.
# CASPER_MAX_UPLOAD_BYTES=104857600

# --- Install layout (environment-only) -----------------------------------------

# Where casper.db lives: session titles, working directories, device logins. Can't
# come from the config file, since it says where data is. Default ~/.casper.
# CASPER_DATA_DIR=/home/youruser/.casper

# Built web app to serve. Default ../web/dist relative to the server's working
# directory; the installer records an absolute path.
# CASPER_WEB_DIST=/home/youruser/.local/share/casper/web/dist

# Node binary the `casper` runner execs, recorded absolute so the service starts
# under systemd's minimal PATH.
# CASPER_NODE=node
