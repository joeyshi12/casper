{
  "name": "@joeyshi12/casper",
  "version": "0.6.0",
  "description": "Web client for kiro-cli over the Agent Client Protocol",
  "license": "MIT",
  "author": "Joey Shi",
  "type": "module",
  "bin": {
    "casper": "dist/casper.js"
  },
  "files": [
    "dist/",
    "assets/agents/"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joeyshi12/casper.git"
  },
  "homepage": "https://github.com/joeyshi12/casper#readme",
  "bugs": {
    "url": "https://github.com/joeyshi12/casper/issues"
  },
  "keywords": [
    "kiro",
    "kiro-cli",
    "acp",
    "agent-client-protocol",
    "ai",
    "coding-agent",
    "web-client"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "workspaces": [
    "shared",
    "server",
    "web"
  ],
  "scripts": {
    "build:shared": "npm run build --workspace @casper/shared",
    "dev": "npm run build:shared && concurrently -n server,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "npm run dev --workspace @casper/server",
    "dev:web": "npm run dev --workspace @casper/web",
    "build": "npm run build:shared && npm run build --workspace @casper/server && npm run build --workspace @casper/web",
    "start": "npm run start --workspace @casper/server",
    "typecheck": "npm run build:shared && npm run typecheck --workspaces --if-present",
    "test": "npm run build:shared && node --import tsx --test tests/unit.ts",
    "e2e": "npm run build:shared && tsx tests/bridge-e2e.ts",
    "build:bundle": "npm run build && node scripts/bundle.mjs",
    "prepack": "npm run build:bundle"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.1",
    "@fastify/cors": "^10.0.1",
    "@fastify/multipart": "^10.1.0",
    "@fastify/static": "^10.1.3",
    "@fastify/websocket": "^11.0.1",
    "fastify": "^5.2.0",
    "pino": "^9.5.0",
    "split2": "^4.2.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "esbuild": "0.25.0",
    "tsx": "^4.19.2",
    "typescript": "5.9.3"
  }
}
